    "componentRequirements": {
        "FLOW_PATH": {
            "evidenceGoal": "trace each hop the value takes from where it is produced to where it ends up, identifying the specific accounts, contracts, or entities it passes through at every step",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "OFFICIAL_DOCS",
                "ONCHAIN_VERIFIABLE"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "RECIPIENT": {
            "evidenceGoal": "identify who ultimately receives the economic benefit, and whether that party is the token holder, the protocol treasury, the team, liquidity providers or another party",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "ONCHAIN_VERIFIABLE",
                "OFFICIAL_DOCS",
                "GOVERNANCE"
            ],
            "tokenStateSensitive": true,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "NET_EFFECT": {
            "evidenceGoal": "determine what happened to the relevant tokens or assets after the mechanism executed, and whether circulating supply, total supply, holder ownership or another economically relevant state actually changed as a result",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "ONCHAIN_VERIFIABLE",
                "OFFICIAL_REPORT",
                "DATA_PROVIDER"
            ],
            "tokenStateSensitive": true,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "DESTINATION": {
            "evidenceGoal": "identify where the assets end up after the mechanism executes - the specific destination account, contract, address or pool - and whether that destination retains, redistributes or retires them",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "ONCHAIN_VERIFIABLE",
                "OFFICIAL_DOCS"
            ],
            "tokenStateSensitive": true,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "CURRENT_STATE": {
            "evidenceGoal": "determine whether the mechanism is operating right now, and if not whether it is paused, deprecated, superseded or not yet started, with evidence current enough to prove present state",
            "freshnessClass": "HIGH_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "ONCHAIN_VERIFIABLE",
                "OFFICIAL_DOCS",
                "OFFICIAL_REPORT"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": true,
            "requiresLiveMechanismState": false
        },
        "MECHANISM_SPEC": {
            "evidenceGoal": "find the specification of how the mechanism is defined to work - its rules, triggers, formulas, rates and conditions - as stated by the project itself or its governing documents",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "OFFICIAL_DOCS",
                "GOVERNANCE"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "SOURCE_OF_VALUE": {
            "evidenceGoal": "identify the concrete economic activity that produces the value or cash flow in question, and the evidence that this activity actually generates it rather than being an aspiration",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "OFFICIAL_DOCS",
                "GOVERNANCE",
                "ONCHAIN_VERIFIABLE"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": false,
            "structuralObligations": [
                "SOV.MECHANICAL_PROVENANCE"
            ],
            "requiresLiveMechanismState": false
        },
        "DURABILITY_BASIS": {
            "evidenceGoal": "determine how durable the mechanism is - whether it is permanent, time-limited, discretionary or revocable - and what could change or end it",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "GOVERNANCE",
                "OFFICIAL_DOCS"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "GOVERNANCE_BASIS": {
            "evidenceGoal": "find the governing decision, vote, proposal or charter that authorises the mechanism, and what it permits, requires or constrains",
            "freshnessClass": "LOW_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "GOVERNANCE"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": false
        },
        "EXECUTION_EVIDENCE": {
            "evidenceGoal": "find evidence that the mechanism has actually executed in practice - real transactions, operations or reported executions - not merely that it is specified or announced",
            "freshnessClass": "MEDIUM_CHANGE",
            "requiredTokenState": null,
            "establishingClasses": [
                "ONCHAIN_VERIFIABLE",
                "OFFICIAL_REPORT"
            ],
            "tokenStateSensitive": false,
            "requiresCurrentState": false,
            "requiresLiveMechanismState": true
        }
    }
