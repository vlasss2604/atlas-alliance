# ATLAS PROOF — Wave 1 WORKER-ONLY environment.
#
# Install as /etc/atlas/worker.env  (owner root, group atlas, mode 0640).
# Read by atlas-worker.service AFTER /etc/atlas/atlas.env. Same format rules.
# None of these is a secret.

# One combined worker serves every phase queue. Hosted egress is direct, so
# the D-149 two-worker split (a local-network workaround) is not needed.
ATLAS_WORKER_CAPABILITIES='SEARCH_EXTRACT,FETCH'

# Structured on-chain retrieval. Exactly "1"; requires the RPC URLs in
# atlas.env, or the worker fails at startup by design.
ONCHAIN_RESEARCH_ENABLED='1'

# Rendered OFFICIAL_DOCS fetch through the isolated headless Chromium.
RENDERED_DOCS_ENABLED='1'

# Where `npx playwright install --with-deps chromium` put the browser. It is
# on the renderer child's environment allowlist, so the child finds it.
PLAYWRIGHT_BROWSERS_PATH='/opt/atlas/ms-playwright'
