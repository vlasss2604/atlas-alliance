# ATLAS PROOF — Wave 1 hosted environment, SHARED by web, worker and owner CLI.
#
# Install as /etc/atlas/atlas.env   (owner root, group atlas, mode 0640).
# NAMES ONLY. Never commit a filled copy. Values go in on the server.
#
# FORMAT: one KEY='value' per line, value in SINGLE quotes. The same file is
# read by systemd (EnvironmentFile=) and by the shell (deploy/wave1/with-env.sh),
# and single quotes are the one form both read identically — a URL with `&`
# or `$` in it breaks unquoted shell sourcing. A value must not itself
# contain a single quote.

# --- runtime ---------------------------------------------------------------
NODE_ENV='production'

# --- database (hosted copy of atlas_dev; never the laptop database) --------
# postgres://<role>:<password>@127.0.0.1:5432/<db>   — loopback only.
DATABASE_URL=''

# --- Telegram (web only) ----------------------------------------------------
# From @BotFather. Verifies Mini App initData; the server never calls the
# Bot API.
BOT_TOKEN=''

# --- session / CSRF / origin (web only) ------------------------------------
# A NEW random value for the hosted environment, e.g. `openssl rand -hex 32`.
# Never reuse the development value.
CSRF_SECRET=''
# Exactly the public origin of the Mini App: https://<domain>  (no trailing
# slash, comma-separated if more than one).
ALLOWED_ORIGINS=''

# --- providers --------------------------------------------------------------
ANTHROPIC_API_KEY=''
BRAVE_SEARCH_API_KEY=''

# --- on-chain RPC (credentials: many providers embed a key in the URL) -----
SOLANA_MAINNET_RPC_URL=''
ETHEREUM_MAINNET_RPC_URL=''

# --- leave UNSET (code defaults are the production choice) -----------------
#   MODEL_GATEWAY            default "anthropic"; "fake" is refused in production
#   SEARCH_GATEWAY_PROVIDER  default "brave"
#   AUTH_MAX_AGE_SEC         default 600
#   AUTH_CLOCK_SKEW_SEC      default 60
#
# --- MUST NOT be set anywhere in production --------------------------------
# deploy/wave1/preflight-env.sh refuses to start a process if any is present:
#   AUTH_DEV_BYPASS  ATLAS_DEV_PROVIDER_PROXY
#   HTTP_PROXY  HTTPS_PROXY  ALL_PROXY  (and lower-case forms)  NODE_USE_ENV_PROXY
