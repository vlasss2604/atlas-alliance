ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
ALLOWED_ORIGINS=
CSRF_SECRET=
DATABASE_URL=

# Desktop local dev only. A browser outside Telegram has no initData, so
# src/client/api.ts posts { dev: true } to /api/auth/telegram. That body is
# served ONLY when this flag is 1 AND the build is NODE_ENV=development.
# Without it the request falls through to real Telegram authentication,
# which needs BOT_TOKEN and cannot succeed in a plain browser — every
# subsequent API call then returns 401 and the UI reports a generic
# "failed to process the question".
AUTH_DEV_BYPASS=1

# Only needed to authenticate REAL Telegram initData (the Mini App running
# inside Telegram). Leave empty for desktop dev with AUTH_DEV_BYPASS=1.
BOT_TOKEN=

# Rendered OFFICIAL_DOCS retrieval (Stage 1), OPTIONAL. Set to 1 to enable
# the isolated headless renderer. Leave empty and the capability does not
# exist in this deployment: resolveRenderedDocsFetcher() refuses rather
# than faking, and research keeps whatever the static path found.
#
# RUNTIME PREREQUISITE: the `playwright` package is a production dependency
# (pinned via package-lock.json), but the Chromium BINARY is not installed
# by npm install. Before enabling, run:
#
#   npx playwright install chromium
#
# Optionally set PLAYWRIGHT_BROWSERS_PATH to relocate the binary; it is one
# of the few variables forwarded to the isolated renderer child.
#
# The renderer runs in a separate process whose environment is built from a
# strict allowlist — it receives NO ATLAS secrets and no database URL — and
# all of its browser traffic is forced through a loopback, deny-by-default
# egress proxy pinned to the one confirmed host being rendered.
RENDERED_DOCS_ENABLED=
PLAYWRIGHT_BROWSERS_PATH=

# Structured on-chain retrieval — TWO variables, and BOTH are required.
# Setting only the endpoint below installs nothing.
#
# This is the DECLARATION: a process installs the on-chain capability only
# when this is exactly "1". Any other value — including "true" — leaves the
# capability uninstalled, and every component that plans a chain read
# records ONCHAIN_RETRIEVER_NOT_CONFIGURED instead. The check is a literal
# comparison in jobs/onchain-capability.ts, deliberately, so "enabled" is a
# decision someone made rather than a string that looked truthy.
#
# Declaring it without a constructible endpoint is a STARTUP FAILURE, not a
# downgrade: a worker that was told to reach a chain and cannot must not
# quietly become a documentary-only engine.
#
# It is not a credential and is safe to commit as a value; the endpoint
# below is the credential.
ONCHAIN_RESEARCH_ENABLED=

# Structured on-chain retrieval (Solana mainnet), OPTIONAL. Leave empty and
# the on-chain acquisition path stays disabled — resolveOnchainRetriever()
# refuses rather than faking, and research simply falls through to the
# normal path.
#
# Treat this value as a CREDENTIAL: many providers embed an API key in the
# URL path. It is never logged, never written to trace, and never placed in
# evidence provenance (which carries the code-owned label
# "solana-mainnet-rpc" instead). Must be https and must not contain
# user:password userinfo.
SOLANA_MAINNET_RPC_URL=

# Structured on-chain retrieval (Ethereum mainnet, TOKEN_SUPPLY only),
# OPTIONAL. Same contract as the Solana endpoint above: a CREDENTIAL, never
# logged, never in trace or provenance (label "ethereum-mainnet-rpc"), https
# only, no userinfo. Installed under its own (chain, network) key when set
# and ONCHAIN_RESEARCH_ENABLED=1; there is no fallback between chains.
# The adapter verifies eth_chainId == 1 before any read.
ETHEREUM_MAINNET_RPC_URL=
