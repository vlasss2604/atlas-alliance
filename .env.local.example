ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
ALLOWED_ORIGINS=
CSRF_SECRET=
DATABASE_URL=

# Desktop local dev only. A browser outside Telegram has no initData, so
# src/client/api.ts posts { dev: true } to /api/auth/telegram. That body is
# served ONLY when this flag is 1 AND the build is NODE_ENV=development.
# Without it the request falls through to real Telegram authentication,
# which needs BOT_TOKEN and cannot succeed in a plain browser — every
# subsequent API call then returns 401 and the UI reports a generic
# "failed to process the question".
AUTH_DEV_BYPASS=1

# Only needed to authenticate REAL Telegram initData (the Mini App running
# inside Telegram). Leave empty for desktop dev with AUTH_DEV_BYPASS=1.
BOT_TOKEN=

# Structured on-chain retrieval (Solana mainnet), OPTIONAL. Leave empty and
# the on-chain acquisition path stays disabled — resolveOnchainRetriever()
# refuses rather than faking, and research simply falls through to the
# normal path.
#
# Treat this value as a CREDENTIAL: many providers embed an API key in the
# URL path. It is never logged, never written to trace, and never placed in
# evidence provenance (which carries the code-owned label
# "solana-mainnet-rpc" instead). Must be https and must not contain
# user:password userinfo.
SOLANA_MAINNET_RPC_URL=
